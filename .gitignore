.claude/
.pytest_cache/
__pycache__/
*.pyc
.DS_Store

# Single Python 3.10+ venv for the whole repo (process_scripts needs
# lerobot -- requires >=3.10).
# README.md instructs users to create this with `python3.11 -m venv .venv`.
/.venv/

# Large reference materials kept locally, not tracked in git (see design doc
# section 1 for why they're referenced by relative path but not committed).
/VLA Research.xlsx
/Qwen_RobotManip.pdf
/2606.02800v4.pdf

# Heavy dataset directory (raw downloads, staged/converted data, final
# processed data, URDFs). Lives under --data-root, which defaults to
# embodied_datasets/data_root/ inside the repo when not overridden -- ignore the
# default location so a script run without --data-root never lands multi-GB
# data in git. See scripts/process_scripts/common/paths.py for the exact layout this
# mirrors. The four public_datasets_raw/public_datasets_staging/
# public_datasets/urdf_assets subdirectories each have a
# force-added (git add -f) .gitkeep placeholder so they still exist after a
# fresh clone despite being gitignored.
embodied_datasets/data_root/

# Design docs / plans written while working the superpowers skill chain
# (brainstorming -> writing-plans) -- process artifacts, kept locally only.
docs/superpowers/

# Subagent-driven-development session artifacts (task briefs, review diffs,
# progress ledger) -- scratch state from the superpowers dev workflow, kept
# locally only. (Was previously only excluded by its own nested
# .superpowers/sdd/.gitignore; listed explicitly here for robustness.)
.superpowers/
